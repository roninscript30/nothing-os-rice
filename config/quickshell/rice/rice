#!/bin/sh
export QML_IMPORT_PATH="$HOME/.local/lib/qt6/qml:${QML_IMPORT_PATH}"
export LD_LIBRARY_PATH="$HOME/.local/lib/qt6:${LD_LIBRARY_PATH}"
#   rice list           все шеллы: папки в ~/.config/quickshell с rice.json
#   rice start          поднять текущий (hypr на старте)
#   rice restart|kill   перезапустить / погасить текущий
#   rice switch <имя>   погасить текущий, вернуть hypr к его конфигу, поднять другой
#   rice lock           блокировка текущего шелла (бинд, hypridle, меню питания)
q=$HOME/.config/quickshell
state=${XDG_STATE_HOME:-$HOME/.local/state}/rice
cur=$(cat "$state/shell" 2>/dev/null)
[ -f "$q/$cur/rice.json" ] || cur=glyph

# терминал и приложения в духе шелла
term() {
    [ -L "$HOME/.config/kitty" ] || ln -sfn /home/marudhu/REPOS/glyph-rice/config/kitty "$HOME/.config/kitty"
    for f in starship.toml fastfetch cava btop qtengine.colors; do
        [ -e "$q/$1/term/$f" ] || continue
        [ -L "$HOME/.config/$f" ] || [ ! -e "$HOME/.config/$f" ] || continue
        ln -sfn "$q/$1/term/$f" "$HOME/.config/$f"
    done
    pkill -USR1 -x cava 2>/dev/null || true
    pkill -USR2 -x btop 2>/dev/null || true
    folders "$1"
    g=org.gnome.desktop.interface
    t=$(gsettings get $g gtk-theme 2>/dev/null)
    if [ -n "$t" ]; then
        gsettings set $g gtk-theme Adwaita
        gsettings set $g gtk-theme "$t"
        gsettings set $g icon-theme Papirus-Dark
        gsettings set $g icon-theme Rice
    fi
}

folders() {
    c=$(cat "$q/$1/term/folders" 2>/dev/null) || return 0
    d=${XDG_DATA_HOME:-$HOME/.local/share}/icons/Rice
    p=/usr/share/icons/Papirus-Dark
    [ "$(cat "$d/color" 2>/dev/null)" = "$c" ] && return 0
    rm -rf "$d"
    dirs=; secs=
    for s in 22x22 24x24 32x32 48x48 64x64; do
        mkdir -p "$d/$s/places"
        for f in "$p/$s/places/folder-$c"*.svg "$p/$s/places/user-$c"*.svg; do
            [ -e "$f" ] || continue
            n=${f##*/}
            ln -s "$f" "$d/$s/places/${n%%-"$c"*}${n#*-"$c"}"
        done
        dirs=$dirs${dirs:+,}$s/places
        secs="$secs
[$s/places]
Context=Places
Size=${s%x*}
Type=Fixed
"
    done
    printf '[Icon Theme]\nName=Rice\nComment=Papirus-Dark, folders in %s (rice)\nInherits=Papirus-Dark,breeze-dark,hicolor\nDirectories=%s\n%s' "$c" "$dirs" "$secs" > "$d/index.theme"
    echo "$c" > "$d/color"
}

# погасить все экземпляры шелла и дождаться
pids() { qs list --all 2>/dev/null | awk -v p="$q/$1/shell.qml" '$1 == "Process" { pid = $3 } $1 == "Config" && $3 == p { print pid }'; }
stop() {
    pids=$(pids "$1")
    [ -n "$pids" ] && kill $pids 2>/dev/null
    for _ in 1 2 3 4 5; do
        alive=
        for p in $pids; do kill -0 "$p" 2>/dev/null && alive=1; done
        [ -n "$alive" ] || break
        sleep 0.1
    done
    [ -n "$pids" ] && kill -9 $pids 2>/dev/null
    pkill -u "$USER" -f "^qs " 2>/dev/null || true
}

case $1 in
    "") echo "$cur" ;;
    list) for f in "$q"/*/rice.json; do basename "$(dirname "$f")"; done ;;
    start)
        # Prevent starting quickshell if not running under Hyprland
        [ -n "$HYPRLAND_INSTANCE_SIGNATURE" ] || exit 0
        [ -n "$(pids "$cur")" ] && exit 0
        mkdir -p "$state"
        term "$cur"
        exec qs -p "$q/$cur" -d ;;
    restart)
        [ -n "$HYPRLAND_INSTANCE_SIGNATURE" ] || exit 0
        term "$cur"
        stop "$cur"
        exec qs -p "$q/$cur" -d ;;
    kill) stop "$cur" ;;
    switch)
        [ -f "$q/$2/rice.json" ] || { echo "rice: нет шелла «$2»" >&2; exit 1; }
        mkdir -p "$state"
        echo "$2" > "$state/shell"
        stop "$cur"
        hyprctl reload >/dev/null 2>&1 || true
        term "$2"
        [ -n "$HYPRLAND_INSTANCE_SIGNATURE" ] || exit 0
        exec qs -p "$q/$2" -d ;;
    lock)
        [ -n "$HYPRLAND_INSTANCE_SIGNATURE" ] || exit 0
        pgrep -f '^qs .*/lock[.]qml' >/dev/null || exec qs -p "$q/$cur/lock.qml" ;;
    *) sed -n '3,9s/^# //p' "$0"; exit 1 ;;
esac
